# Database
DATABASE_URL=your_neon_postgresql_connection_string_here

# ===== Auth.js (NextAuth v5) =====
# Generate with: npx auth secret
AUTH_SECRET=your_auth_secret_here

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# GitHub OAuth (https://github.com/settings/developers)
AUTH_GITHUB_ID=your_github_client_id_here
AUTH_GITHUB_SECRET=your_github_client_secret_here

# Resend (Magic Link emails - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# NextAuth URL (set to your production URL in prod)
NEXTAUTH_URL=http://localhost:3000

# ===== Legacy Session (kept during migration) =====
# Session Secret (generate a random 32-character string)
SESSION_SECRET=your_session_secret_here

# ===== Legacy Email (SMTP - for password reset) =====
# For Gmail: Use App Password from https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM_NAME=QR Noir Tech

# Stripe Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret (get from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
